# Production environment variables for RevSecureCloud backend
# Replace placeholder values before deploying.

# App
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_URL=https://api.revsecurecloud.com
FRONTEND_URL=https://revsecurecloud.com
# Explicit CORS allow-list — must include every frontend origin that calls the API
CORS_ORIGINS=https://revsecurecloud.com,https://www.revsecurecloud.com

# Database (set to your Neon/Postgres connection string)
# Example: postgresql://neondb_owner:REPLACE_ME@ep-xxx.neon.tech/revsecurecloud?sslmode=require
DATABASE_URL=postgresql://<NEON_USER>:<NEON_PASSWORD>@<NEON_HOST>/<DB_NAME>?sslmode=require

# Redis (only required if you use BullMQ job queues)
# Set REDIS_ENABLED=true and provide a reachable REDIS_URL when using Redis.
REDIS_ENABLED=false
# REDIS_URL=redis://:<password>@redis-host:6379

# JWT secrets (REPLACE with securely generated values, minimum 32 chars)
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_RANDOM_REFRESH_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security / performance
BCRYPT_ROUNDS=12
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Stripe (if used)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# GitHub OAuth (if used)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://api.revsecurecloud.com/api/v1/auth/github/callback

# Feature flags
ENABLE_DEMO_DATA=false
USE_CONNECTOR_ENGINE_V2=false
LOG_LEVEL=info

# --- AI Intelligence / Agent (Phase 4) ---
# Enable only if you intend to use AI features. At least one provider key is required.
ENABLE_AI_ENGINE=true
AI_DEFAULT_MODEL=groq/llama-3.1-8b-instant
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.3
AI_QUOTA_PER_COMPANY=100

# Provider keys (set the keys you will use in prod)
GROQ_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional: override API URL used by the frontend (Vite)
# The front-end needs `VITE_API_URL` when building for prod (set in your Vite/hosting env)
# VITE_API_URL=https://api.revsecurecloud.com

# ─── Render Environment Variables Checklist ────────────────────────────────
# The following MUST be configured in your Render service dashboard
# (Environment → Add Environment Variable). Do NOT commit real secrets to git.
#
# REQUIRED:
#   NODE_ENV              = production
#   PORT                  = 3000
#   APP_URL               = https://api.revsecurecloud.com
#   FRONTEND_URL          = https://revsecurecloud.com
#   CORS_ORIGINS          = https://revsecurecloud.com,https://www.revsecurecloud.com
#   DATABASE_URL          = postgresql://... (Neon connection string)
#   JWT_SECRET            = <64+ char random string>
#   JWT_REFRESH_SECRET    = <64+ char random string>
#   CONNECTOR_ENCRYPTION_KEY = <64 hex chars — run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
#   REDIS_ENABLED         = false
#
# OPTIONAL (AI features):
#   ENABLE_AI_ENGINE      = true
#   GROQ_API_KEY          = <your Groq key>
#   OPENAI_API_KEY        = <your OpenAI key>
#
# OPTIONAL (Stripe):
#   STRIPE_SECRET_KEY     = sk_live_...
#   STRIPE_WEBHOOK_SECRET = whsec_...
#
# After every deployment that includes a migration, run once:
#   npx prisma migrate deploy
# (or configure Render start command as: npx prisma migrate deploy && node dist/server.js)
