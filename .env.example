# ─── App ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_URL=http://localhost:3000        # Production: 
FRONTEND_URL=http://localhost:5173   # Production:
# Comma-separated allowed CORS origins (overrides FRONTEND_URL + APP_URL when set)
# Production: CORS_ORIGINS=
CORS_ORIGINS=

# ─── Database ──────────────────────────────────────────────────────
DATABASE_URL=

# Production DB URL — set locally for scripts/run-prod-migrations.js
# NEVER commit this value. Add to GitHub Secrets as PROD_DATABASE_URL.
# PROD_DATABASE_URL=

# ─── Demo data (development / staging only) ────────────────────────
# Set to "true" and run: npm run demo:seed
# NEVER set to "true" in production — DemoDataService blocks it at runtime.
ENABLE_DEMO_DATA=false
DEMO_COMPANY_SLUG=demo

# ─── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-very-long-random-string-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# ─── Bcrypt ────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Stripe ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ─── GitHub OAuth ──────────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=
# Production: GITHUB_CALLBACK_URL=

# ─── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Connector Engine v2 ───────────────────────────────────────────
# Set to "true" to activate the new Adapter-pattern connector layer.
# Defaults to false — all existing Stripe / GitHub paths remain unchanged.
USE_CONNECTOR_ENGINE_V2=false

# ─── AI Intelligence Engine (Phase 3) ────────────────────────────────
# Set to "true" to activate the statistical analysis engine.
# Routes are invisible (404) when false.
ENABLE_AI_ENGINE=true
# Required only if enrichWithLLM=true is used in POST /ai/run
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=400
